# ----------------------------------------------------------------
# Variables d'environnement Claire Platform
# Copie ce fichier en .env.local et remplis les valeurs
# Ne JAMAIS commit le fichier .env.local
# ----------------------------------------------------------------

# Supabase (récupère depuis Settings → API de ton projet Supabase)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJI...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...

# Anthropic (pour le chatbot Claire)
ANTHROPIC_API_KEY=sk-ant-...

# Assistant PRIVÉ de préparation (/agent + /api/agent) — chat perso de Tafsir.
# Code d'accès qui protège l'endpoint : sans lui, n'importe qui sur l'URL pourrait
# cramer ta clé API. Mets une valeur LONGUE et aléatoire (20+ caractères).
# Sans cette variable, /api/agent refuse toute requête (503). À définir dans Vercel.
AGENT_ACCESS_CODE=
# Sous-domaine PRIVÉ qui héberge l'atelier (ex. atelier.claireassistante.fr).
# Cloisonnement : /agent, /agent.html et /api/agent ne répondent QUE sur cet hôte ;
# sur la vitrine (app.claireassistante.fr) ils renvoient 404 (invisibles côté client).
# Fail-closed : tant que AGENT_HOST est vide, l'atelier est fermé (404) partout.
AGENT_HOST=

# Cloudflare Turnstile (anti-bot du chat public — OPTIONNEL mais recommandé).
# Tant que TURNSTILE_SECRET_KEY est vide, l'anti-bot est inactif (rien ne change).
# Une fois défini, le chat du cabinet de démo exige un jeton Turnstile valide.
# Câblage front : voir le commentaire en tête de js/demo-chat.js.
TURNSTILE_SECRET_KEY=

# ----------------------------------------------------------------
# TWILIO — Débordement téléphonique (appel manqué → SMS → chat Claire)
# Voir docs/TWILIO.md pour la mise en service pas à pas.
# ----------------------------------------------------------------
# Identifiants du compte Twilio (Console → Account Info).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Origine publique utilisée pour valider la signature des webhooks Twilio et
# construire les liens SMS. Optionnel : déduit des en-têtes si absent, mais le
# définir explicitement (ex. https://app.claireassistante.fr) est plus fiable.
TWILIO_PUBLIC_URL=
# Échappatoire de TEST uniquement (jamais en production) : 'true' désactive la
# validation de signature Twilio en local. Laisser vide en prod.
TWILIO_SKIP_SIGNATURE=

# ----------------------------------------------------------------
# PURGE / RÉTENTION DES DONNÉES (RGPD)
# ----------------------------------------------------------------
# Secret protégeant le cron de purge /api/cron/purge. Vercel l'envoie
# automatiquement en Authorization: Bearer. Générer : openssl rand -hex 32
# Sans ce secret, la purge NE S'EXÉCUTE PAS (fail-closed).
CRON_SECRET=
# Durée de rétention en jours (défaut 730 = 24 mois). Plancher de sécurité : 30 j.
# À aligner avec la durée annoncée dans confidentialite.html.
RETENTION_DAYS=730

# Minimisation des données de santé (posture "prise de contact"). ON PAR DÉFAUT.
# Quand actif : la plateforme NE STOCKE PAS le contenu médical (messages détaillés,
# motif, souhait) — seuls le contact + « rappel souhaité » + urgence sont conservés ;
# le détail complet est transmis au cabinet via le webhook (NOTIFY_WEBHOOK_URL).
# Réduit fortement l'exposition "hébergement de données de santé".
# Mettre 'false' UNIQUEMENT après validation (avocat/DPO) pour re-stocker le motif.
# (Le cabinet de démo DEMO_CABINET_ID est toujours exempté.)
MINIMIZE_HEALTH_DATA=true

# Webhook d'automatisation pour notifier le cabinet (optionnel) — compatible Make,
# n8n, Zapier… Voir docs/MAKE.md pour la recette Make pas à pas.
NOTIFY_WEBHOOK_URL=https://hook.eu2.make.com/xxxxxxxxxxxxxxxx
# Secret partagé envoyé en en-tête X-Claire-Secret au webhook (recommandé si
# NOTIFY_WEBHOOK_URL est défini) : permet à l'automatisation de rejeter les appels non authentifiés.
NOTIFY_WEBHOOK_SECRET=
# (Rétrocompatibilité : N8N_WEBHOOK_URL / N8N_WEBHOOK_SECRET restent acceptés si déjà configurés.)

# Origines autorisées pour les endpoints publics (/api/chat, /api/contact)
# Séparer par virgule. Mettre '*' pour autoriser tout le monde (déconseillé en prod).
# Exemple : https://claireassistante.fr,https://www.claireassistante.fr
ALLOWED_ORIGINS=https://claireassistante.fr,https://www.claireassistante.fr

# Cabinet de démonstration (page d'accueil) — UUID du cabinet "Démo".
# Active la carte "ce que reçoit le cabinet" sous la démo (/api/demo-summary).
# Doit correspondre à DEMO_CABINET_ID dans js/demo-chat.js.
DEMO_CABINET_ID=

# Administrateur(s) autorisé(s) à inviter de nouveaux cabinets (/api/invite-cabinet).
# Liste d'emails séparés par des virgules. Seuls ces comptes voient l'outil "Inviter un cabinet".
# Exemple : contact@claireassistante.fr
ADMIN_EMAILS=

# URL publique du site, utilisée comme lien de retour dans l'email d'invitation
# (page /bienvenue.html). Optionnel : déduit automatiquement si absent.
# Exemple : https://app.claireassistante.fr
PUBLIC_SITE_URL=
